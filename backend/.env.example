# Super Inventory Backend Environment Variables
# Copy to .env and fill in your values

NODE_ENV=development
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=super_inventory
DB_PASSWORD=super_inventory_pass
DB_NAME=super_inventory_pos

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=8h

# Admin default (change after first login)
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin@1234

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://192.168.1.100:8081
