NODE_ENV=development
PORT=5000

# Supabase Cloud PostgreSQL & Storage (Free Tier)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend.com Email API (Free Tier: 3,000 emails/mo)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Super Inventory <onboarding@resend.dev>

# Local MySQL Database (Fallback)
DB_HOST=localhost
DB_PORT=3306
DB_USER=super_inventory
DB_PASSWORD=super_inventory_pass
DB_NAME=super_inventory_pos

# JWT Auth
JWT_SECRET=super_inventory_super_secret_jwt_key_2024_change_in_production
JWT_EXPIRES_IN=8h

# Admin Default Seed
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=Admin@1234

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://localhost:8081,http://127.0.0.1:5000
