{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/flutter_app/web_preview/manifest.json"
    },
    {
      "source": "/logo.png",
      "destination": "/flutter_app/web_preview/logo.png"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/flutter_app/web_preview/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/flutter_app/web_preview/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=*, microphone=*"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
